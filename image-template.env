# Here we set a bunch of parameters for your image build

# output image name, usually same as repo name, change as needed
IMAGE_NAME=nitro-bazzite

# Make this the same as your github username/organisation
REPO_ORGANIZATION="hyacinthesistic"

IMAGE_DESC="Bazzite KDE (nvidia-open) with a signed Linuwu-Sense module and temperature-based fan control for the Acer Nitro ANV15-51"
IMAGE_KEYWORDS="bazzite,bootc,oci,linux,acer,nitro,linuwu-sense"

# Put your own image here for a fancy profile on https://artifacthub.io/!
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/76456281?s=200&v=4"
DEFAULT_TAG="latest"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
